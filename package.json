{
  "name": "jsxword-dl",
  "version": "0.0.1",
  "description": "JavaScript CLI download tool for online crossword puzzles",
  "main": "src/xword-dl.js",
  "types": "src/xword-dl.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/xword-dl.d.ts",
      "import": "./src/xword-dl.js"
    },
    "./cli": "./src/index.js"
  },
  "bin": {
